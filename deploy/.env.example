# deploy/.env -- copy to .env (untracked, mode 600) and fill every CHANGE_ME.
# Generate hex secrets with `openssl rand -hex 24` (hex needs no escaping inside
# the Mongo and Redis URLs). A shell export of any name below is ignored by
# deploy.ts: this file decides. `bun deploy/deploy.ts --dry-run` lists what is
# still missing without touching anything.

# ── Docker namespace ─────────────────────────────────────────────────────────
# Empty is fine: containers are named storix-*. A second stack on the same
# machine sets one (e.g. demo) plus its own hostname below.
STACK_PREFIX=

# ── DNS namespace ────────────────────────────────────────────────────────────
# The one public hostname. The proxied *.softistx.com wildcard already covers
# it (Cloudflare Tunnel): no DNS record to add. The API's router takes /public/
# on it, the UI's (profile ui) the rest.
UI_HOSTNAME=storix.softistx.com
# Always https: the API runs with NODE_ENV=production and refuses an http
# UI_ORIGIN.
PUBLIC_SCHEME=https
# traefik entrypoint and TLS (leave as is).
TRAEFIK_HTTP_ENTRYPOINTS=websecure
TRAEFIK_USE_TLS=true
# The proxies in front of the API: addresses or CIDR ranges, never a hop count
# (the API refuses one at startup). The docker range covers Traefik.
TRUSTED_PROXIES=172.16.0.0/12

# ── Builds ───────────────────────────────────────────────────────────────────
# The UI checkout the image is built from with --ui (default ../../storix-ui).
# UI_CONTEXT=../../storix-ui
# The widget's built `dist` (run `bun run build` in storix-widget first), mounted
# read only into the UI at /widget, which serves it (default
# ../../storix-widget/dist, relative to deploy/). Needed with --ui.
# WIDGET_DIST=../../storix-widget/dist
# Image tags: [<STACK_PREFIX>-]storix-api:${TAG}, -ui, -backup, -s3-init.
TAG=local

# ── Secrets (all required) ───────────────────────────────────────────────────
# Read only on the first start of an empty Mongo volume: `openssl rand -hex 24`.
MONGO_ROOT_PASSWORD=CHANGE_ME
# Keyfile content for the replica set: `openssl rand -base64 48`.
MONGO_KEYFILE=CHANGE_ME
# `openssl rand -hex 24` each.
MONGO_APP_PASSWORD=CHANGE_ME
# Optional, only with --backup: the user with the `backup` role that the nightly
# full-instance dump uses. Leave it out and no backup user is created.
# MONGO_BACKUP_PASSWORD=
REDIS_PASSWORD=CHANGE_ME
# Shared by the API and the UI: the UI sends it as x-storix-proxy-secret and the
# API honours the forwarded client address of /graphql only with it (/public/,
# called by the widget through Traefik, is exempt). 32 characters or more:
# `openssl rand -hex 32`.
API_PROXY_SECRET=CHANGE_ME
# SeaweedFS admin identity (seaweedfs and s3-init only): a name (`openssl rand -hex 6`) and
# `openssl rand -hex 24`.
S3_ADMIN_ACCESS_KEY=CHANGE_ME
S3_ADMIN_SECRET_KEY=CHANGE_ME
# The API's own S3 identity, limited to the bucket: access key `openssl rand -hex 8`
# (3 to 20 characters), secret `openssl rand -hex 24`.
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Sealing keys of the second factor, `id:key[,id:key]`: the first seals, every
# one opens. `k1:$(openssl rand -base64 32)`. Keep the old key when rotating, or
# enrolled second factors stop opening.
TOTP_KEYS=CHANGE_ME
# The key the audit log hashes client addresses with, 32 characters or more:
# `openssl rand -base64 32`. Changing it starts a new series of hashes.
AUDIT_IP_KEY=CHANGE_ME

# ── Mail ─────────────────────────────────────────────────────────────────────
# Every link of a mail (invitation, magic link, password reset) starts with
# https://UI_HOSTNAME. Mail leaves through bumail's Mail API (MAIL_TRANSPORT=
# bumail, the default): http://bumail-app:8090/graphql on the external docker
# network `bumail-internal`, the app's `bumail_...` service key read from
# deploy/secrets/mail_api_key (mode 600, owned by uid 1000, never in this file:
# docs/deployment.md, "Mail"). MAIL_FROM must be on a domain verified in bumail.
MAIL_FROM=no-reply@softistx.com
# MAIL_TRANSPORT=bumail
# BUMAIL_URL=http://bumail-app:8090/graphql
# The SMTP fallback, kept one release for a rollback: MAIL_TRANSPORT=smtp and
# MAIL_URL, one nodemailer URL with its login percent-encoded (@ is %40):
#   smtp://no-reply%40softistx.com:PASSWORD@bumail:587?tls.servername=mail.softistx.com
# MAIL_URL also serves the backup alert (BACKUP_ALERT_TO below), which mails over SMTP.
# MAIL_URL=
# The address the UI's legal pages give for questions (the UI refuses to start
# in production without it).
CONTACT_EMAIL=CHANGE_ME

# ── Backups (optional: only with `deploy.ts --backup`) ──────────────────────
# Off by default: leave BACKUP_S3_* and MONGO_BACKUP_PASSWORD unset and nothing
# about the backup is required. With --backup all four BACKUP_S3_* and
# MONGO_BACKUP_PASSWORD are required.
# The offsite bucket any S3-compatible provider hosts (docs/deployment.md,
# "Offsite bucket, one-time setup"). The key writes and reads that bucket only:
# it cannot delete or create one.
# BACKUP_S3_ENDPOINT=CHANGE_ME
# BACKUP_S3_BUCKET=CHANGE_ME
# BACKUP_S3_ACCESS_KEY=CHANGE_ME
# BACKUP_S3_SECRET_KEY=CHANGE_ME
# Offsite folder; default storix, or storix-<STACK_PREFIX>.
# BACKUP_S3_PREFIX=
# Hour of the nightly run, UTC, 00 to 23.
# BACKUP_HOUR=03
# Days of dumps kept in the backup volume (the offsite expiry is a bucket rule).
# BACKUP_RETENTION_DAYS=14
# Mailed through the SMTP MAIL_URL when a run fails or no backup succeeded for 26 h.
# Empty: no mail.
# BACKUP_ALERT_TO=

# ── Not secret ───────────────────────────────────────────────────────────────
MONGO_APP_USER=sx_app
MONGO_BACKUP_USER=sx_backup
# The shared database and the prefix of a workspace's: <prefix><id>.
MONGO_CORE_DATABASE=storix_core
MONGO_WORKSPACE_PREFIX=storix_ws_
S3_BUCKET=storix-files
S3_REGION=us-east-1
# Seconds between two runs of the scheduled scripts (the jobs service).
# JOBS_SWEEP_EVERY=3600
# JOBS_RETENTION_EVERY=3600
# JOBS_RECONCILE_EVERY=86400
