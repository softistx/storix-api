{
  "name": "storix-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "nxgt-graphql-scalars typedefs --out && nxgt-graphql-validation typedefs --out && graphql-codegen --config codegen.ts",
    "dev": "bun scripts/dev.ts",
    "dev:api": "NODE_ENV=development bun --watch src/server.ts",
    "db:sync": "bun src/scripts/db-sync.ts",
    "db:migrate": "bun src/scripts/db-migrate.ts",
    "workspace:quota": "bun src/scripts/workspace-quota.ts",
    "quota:reconcile": "bun src/scripts/quota-reconcile.ts",
    "storage:sweep": "bun src/scripts/storage-sweep.ts",
    "retention": "bun src/scripts/retention.ts",
    "services:up": "docker compose up -d --wait mongo redis mailpit seaweedfs && docker compose run --rm mongo-init && docker compose up -d media-bucket",
    "services:down": "docker compose down",
    "build": "bun run generate && bun build src/server.ts src/worker.ts --target=bun --outdir=dist --minify --sourcemap=linked",
    "start": "NODE_ENV=production bun dist/server.js",
    "worker": "NODE_ENV=development bun --watch src/worker.ts",
    "start:worker": "NODE_ENV=production bun dist/worker.js",
    "schema:print": "bun src/scripts/schema-print.ts",
    "test": "bun test --timeout=15000",
    "test:affected": "bun src/scripts/affected-tests.ts",
    "typecheck": "bun check",
    "lint": "biome lint",
    "format": "biome format --write",
    "fix": "biome check --write",
    "context:check": "bun src/scripts/context-codes-check.ts",
    "deps:check": "bun src/scripts/janus-imports-check.ts",
    "check:ci": "biome ci && bun run context:check && bun run deps:check",
    "verify": "bun run generate && bun run schema:print --check && bun run check:ci && bun run typecheck && bun run test && bun run build",
    "verify:pr": "bun run generate && bun run schema:print --check && bun run check:ci && bun run typecheck && bun run test:affected origin/develop && bun run build"
  },
  "dependencies": {
    "@alxia/access": "^0.2.3",
    "@alxia/core": "^0.25.0",
    "@alxia/env": "^0.5.0",
    "@alxia/graphql": "^0.16.4",
    "@alxia/i18n": "^0.6.1",
    "@alxia/language": "^0.3.21",
    "@alxia/media": "^0.11.0",
    "@alxia/modules": "^0.4.0",
    "@alxia/tenancy": "^0.7.1",
    "@graphql-tools/merge": "^10.0.6",
    "@napi-rs/canvas": "^1.1.0",
    "@nxgt/graphql-client": "^0.7.0",
    "@nxgt/graphql-scalars": "^0.7.1",
    "@nxgt/graphql-validation": "^0.9.0",
    "@softistx/ai-anthropic": "^0.4.1",
    "@softistx/ai-core": "^0.7.1",
    "@softistx/ai-ollama": "^0.3.2",
    "@softistx/ai-telemetry": "^0.3.3",
    "@softistx/image": "^0.6.0",
    "@softistx/janus": "^0.73.0",
    "@softistx/janus-graphql": "^0.30.0",
    "@softistx/janus-mail": "^0.26.16",
    "@softistx/janus-mongo": "^0.30.2",
    "@softistx/mail": "^1.6.0",
    "@softistx/mail-smtp": "^1.1.0",
    "@softistx/mongo": "^0.30.1",
    "@softistx/redis": "^0.24.0",
    "@softistx/s3": "^0.13.0",
    "@softistx/telemetry": "^0.4.2",
    "dataloader": "^2.2.3",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.2",
    "mongodb": "^7.8.0",
    "nodemailer": "^8",
    "pdfjs-dist": "^6.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@graphql-tools/utils": "^13.1.3",
    "@nxgt/graphql-codegen-zod": "^0.4.1",
    "@softistx/ai-testing": "^0.3.1",
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server-core": "^11.3.0",
    "redis-memory-server": "^0.17.2",
    "typescript": "^7.0.2"
  }
}
