"""
What a workspace stores against its quota. Sizes are bytes. A blob that several
files share (a copy) counts once, and versions and the trash count too.
"""
type Storage {
  "The bytes the workspace may store; 10 GiB unless a platform administrator changed it."
  quotaBytes: Float!
  "The bytes stored: `currentBytes` + `versionBytes` + `trashBytes`."
  usedBytes: Float!
  "Of `usedBytes`, what live files hold."
  currentBytes: Float!
  "Of `usedBytes`, what only older versions hold."
  versionBytes: Float!
  "Of `usedBytes`, what only the trash holds."
  trashBytes: Float!
  "The files of the workspace, copies and trashed ones included."
  files: Int!
}

extend type Query {
  """
  The workspace's storage: its quota, what is used and the split. Any member
  may read it. 400 `workspaces.errors.workspace-required`, 404
  `workspaces.errors.not-found`; 401 `auth.errors.api-key-not-accepted`.
  """
  storage: Storage!
}
