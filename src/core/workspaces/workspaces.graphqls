"A workspace: the tenant. Its files, members and settings are its own, in a database of its own."
type Workspace {
  id: ID!
  "Lower case words joined by hyphens, unique across workspaces; the tenant header may carry it instead of the id."
  slug: String!
  name: String!
  "The caller's role in it."
  myRole: WorkspaceRole!
  createdAt: DateTime!
  "What an administrator tunes: the trash's and the versions' retention."
  settings: WorkspaceSettings!
}

"""
The workspace's settings. The retention job (`bun run retention`) applies the
three of them.
"""
type WorkspaceSettings {
  "Days a trashed item stays in the trash before it is purged; 30 by default."
  trashDays: Int!
  "Most versions a file keeps; 20 by default."
  versionsMax: Int!
  "Days a version is kept; 90 by default. A file's current version is never dropped."
  versionsDays: Int!
}

"The settings to change; the ones left out keep their value."
input WorkspaceSettingsInput {
  trashDays: Int @constraint(min: 1, max: 3650)
  versionsMax: Int @constraint(min: 1, max: 1000)
  versionsDays: Int @constraint(min: 1, max: 3650)
}

input CreateWorkspaceInput {
  "1 to 100 characters, spaces around are dropped."
  name: String! @constraint(minLength: 1, maxLength: 100)
  "1 to 40 characters: lower case letters, digits and hyphens, not starting or ending with a hyphen, and not 24 hexadecimal digits (an id)."
  slug: String!
    @constraint(
      minLength: 1
      maxLength: 40
      pattern: "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    )
}

extend type Query {
  """
  The request's workspace, named by the `x-storix-workspace` header (its id or
  its slug), with the caller's role. 400 `workspaces.errors.workspace-required`
  without the header; 404 `workspaces.errors.not-found` for an unknown workspace
  AND for one the caller does not belong to; 401
  `auth.errors.api-key-not-accepted` for a personal API key.
  """
  workspace: Workspace!
  "The workspaces the caller belongs to, by name. Needs a session, no header."
  myWorkspaces: [Workspace!]!
}

extend type Mutation {
  """
  Creates a workspace, with its own database, and makes the caller its OWNER.
  Needs a session. 409 `workspaces.errors.slug-taken`; 400
  `validation.errors.invalid-input` (a slug of 24 hexadecimal digits or an
  empty name); 429 `auth.errors.rate-limited`.
  """
  createWorkspace(input: CreateWorkspaceInput!): Workspace!

  """
  Changes the workspace's settings. Needs `workspace:manage` (OWNER and ADMIN).
  Audited as `workspace.settings`. 400 `validation.errors.invalid-input` for a
  value out of range.
  """
  updateWorkspaceSettings(input: WorkspaceSettingsInput!): WorkspaceSettings!

  """
  Renames the request's workspace: its display name only, the slug and the id
  stay. Needs `workspace:manage` (OWNER and ADMIN; 403 `auth.errors.forbidden`
  for a MEMBER). Audited as `workspace.rename`. 400
  `validation.errors.invalid-input` for a blank name or one over 100
  characters; 400 `workspaces.errors.workspace-required`; 404
  `workspaces.errors.not-found`.
  """
  renameWorkspace(
    name: String! @constraint(minLength: 1, maxLength: 100)
  ): Workspace!
}
