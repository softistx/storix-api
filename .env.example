# Copy to .env, which Bun loads on every command: bun run dev, bun test, bun start.
# `bun test` and `bun run verify` need nothing below.

# number, optional, default 3000
PORT=3000

# Host ports of the dev services (docker-compose.yml). They differ from the other products' dev stacks so the
# stacks can run side by side. Change a port together with the URL that uses it.
# MONGO_PORT=27019
# REDIS_PORT=6381
# MAILPIT_SMTP_PORT=1027
# MAILPIT_WEB_PORT=8027
# S3_PORT=8333

# mongodb://, required. docker-compose.yml starts a one-node replica set on MONGO_PORT.
MONGO_URI=mongodb://localhost:27019/?replicaSet=rs0&directConnection=true
# The core database and the prefix of each workspace's (`<prefix><id>`).
# MONGO_CORE_DATABASE=storix_core
# MONGO_WORKSPACE_PREFIX=storix_ws_
# How many workspaces' databases stay open (least recently used out), integer 1 to 10000, default 100.
# MONGO_WORKSPACE_CACHE_SIZE=100
# storix-ui's origin: every link of a mail starts with it (https in production).
# UI_ORIGIN=http://localhost:5173
# The address mails are sent from.
# MAIL_FROM=noreply@storix.test
# smtp:// or smtps:// (Mailpit: smtp://localhost:1027); unset, mails are printed to the console.
# MAIL_URL=smtp://localhost:1027
# id:key,id:key, required in production: the keys that seal the accounts' TOTP secrets, each 32
# random bytes in base64 (`openssl rand -base64 32`). The first seals, every one opens: to rotate,
# put the new one first and keep the old one. A development key stands in elsewhere.
# TOTP_KEYS=2026-11:replace-with-openssl-rand-base64-32
# at least 32 characters, required in production: the key the audit log hashes client addresses with
# (HMAC-SHA256; `openssl rand -base64 32`). Changing it starts a new series of hashes. A development key stands in elsewhere.
# AUDIT_IP_KEY=replace-with-openssl-rand-base64-32-or-longer
# redis://, required in production (rate limits, queues, tokens); unset elsewhere (the renditions worker needs it; without it files get no previews). docker-compose.yml: redis://localhost:6381.
# REDIS_URL=redis://localhost:6381
# Proxies in front of the API (addresses or CIDR ranges, comma separated; the docker network is 172.16.0.0/12).
# Required in production.
# TRUSTED_PROXIES=172.16.0.0/12
# The secret storix-ui's server sends as `x-storix-proxy-secret` (the same variable on both services),
# at least 32 characters. Required in production.
# API_PROXY_SECRET=
# S3-compatible store of the files; set the three together or none. docker-compose.yml's SeaweedFS:
# http://localhost:8333, bucket storix-files.
# S3_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
# S3_BUCKET=storix-files
# S3_ACCESS_KEY=storix-dev
# S3_SECRET_KEY=storix-dev-secret

# Attempts per client address, "<count>/<seconds>" (counted in Redis: they apply only when REDIS_URL is set).
# RATE_LIMIT_SIGN_UP=10/3600
# RATE_LIMIT_SIGN_IN=30/900
# RATE_LIMIT_PASSWORD_RESET=10/3600
# RATE_LIMIT_WORKSPACE_CREATE=10/3600
# RATE_LIMIT_INVITATION_SEND=50/3600
# RATE_LIMIT_INVITATION_CODE=30/900
